<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="icon" href="/favicon.svg" type="image/x-icon">
    <title><%= student ? "Update Student" : "Add Student" %></title>
  </head>
  <body class="container py-3">
  <%- include('partials/header') %>

  <div class="card p-4">
    <h2 class="mb-4"><%= student ? "Update Student" : "Add Student" %></h2>
    <form action="/students/<%= student ? student.roll + '?_method=PATCH' : '' %>" method="post" class="row g-3">
      <div class="col-12 col-md-6">
        <label for="roll" class="form-label">Roll Number:</label>
        <input type="text" id="roll" name="roll" value="<%= student ? student.roll : '' %>" required <%= student ? 'readonly' : '' %> class="form-control">
      </div>
      <div class="col-12 col-md-6">
        <label for="name" class="form-label">Name:</label>
        <input type="text" id="name" name="name" value="<%= student ? student.name : '' %>" required class="form-control">
      </div>
      <div class="col-12 col-md-6">
        <label for="guardianPhoneNumber" class="form-label">Guardian Phone Number:</label>
        <input type="text" id="guardianPhoneNumber" name="guardianPhoneNumber" value="<%= student ? student.guardianPhoneNumber : '' %>" class="form-control">
      </div>
      <% const skillsList = ['dancing', 'drawing', 'painting', 'singing', 'story writing', 'playing chess', 'playing cricket', 'playing soccer', 'performing orchestra', 'coding'] %>
      <div class="col-12">
        <label for="skills" class="form-label">Skills (select multiple):</label>
        <select name="skills[]" id="skills" multiple class="form-select">
          <% skillsList.forEach(skill => { %>
            <option value="<%= skill %>" <%= student && student.skills.includes(skill) ? 'selected' : '' %>><%= skill.charAt(0).toUpperCase() + skill.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-success w-100"><%= student ? 'Update' : 'Add' %></button>
      </div>
    </form>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
